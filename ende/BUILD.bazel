load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//bzl:copts.bzl", "RAMA_COPTS")

cc_library(
    name = "ende",
    hdrs = glob(["*.h"]),
    copts = RAMA_COPTS,
    visibility = ["//visibility:public"],
)

[cc_test(
    name = src.removesuffix(".cc"),
    size = "small",
    srcs = [src],
    copts = RAMA_COPTS,
    deps = [
        ":ende",
        "@hastur//etest",
    ],
) for src in glob(["*_test.cc"])]
